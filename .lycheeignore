# Exclusions for the Link check workflow (.github/workflows/link-check.yml).
# One regular expression per line. Every entry says why it is skipped.

# tel: and sms: links are phone numbers, not web pages, so there is nothing to fetch.
^tel:
^sms:

# linkedin.com answers automated requests with HTTP 999 (bot wall), never with
# the profile page. It is the author's profile, not a resource for users.
^https?://([a-z]+\.)?linkedin\.com/

# TEMPORARY: the Access To hub (dougdevitre.org) returned 404 to the link check
# in sibling repos on 2026-10-18. It is the hub's own site, not a resource for
# people seeking help. Remove this line once the hub serves again.
^https?://(www\.)?dougdevitre\.org

# The install file is published by .github/workflows/skill-package.yml when this
# change reaches main, so it 404s until the first skill-latest release exists.
# TEMPORARY: remove this line once the release is published.
^https://github\.com/dougdevitre/access-to-peace/releases/download/skill-latest/

# childwelfare.gov (Child Welfare Information Gateway) returns 404 to link
# checkers for every URL, including the home page, while the page loads for a
# browser-like fetch (found by the same check in access-to-safety, 2026-10-18).
# Bot filtering, not a dead site. Linked from SKILL.md and crisis-resources.md
# as the way to find another state's child-abuse reporting line.
^https?://(www\.)?childwelfare\.gov
